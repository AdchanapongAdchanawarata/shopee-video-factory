# ========================================================
# Shopee AI Affiliate Hybrid Video Factory Configuration
# ========================================================

# Google Gemini API Key (Required for live Gemini 2.5 Flash scriptwriting & Vision Curator)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Settings (Optional: default uses free edge-tts)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Playwright & Chrome Automation Settings
# Connect to an existing Chrome instance with Shopee login session:
# macOS: /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --remote-debugging-port=9222
# Windows: & "C:\Program Files\Google\Chrome\Application\chrome.exe" --remote-debugging-port=9222 --user-data-dir="C:\ChromeShopeeProfile"
CHROME_DEBUG_PORT=9222
CHROME_USER_DATA_DIR=./workspace_data/chrome_profile
HEADLESS=false

# Affiliate & Video Generation Rules
MIN_AMS_COMMISSION_RATE=8.0
MIN_SELLER_RATING=4.7
MIN_30D_SALES=100

# Voiceover Defaults
EDGE_TTS_VOICE=th-TH-PremwadeeNeural
EDGE_TTS_RATE=+15%
